{
  "extends": [
    "@rocketseat/eslint-config/react", 
    "next/core-web-vitals",
    "next/typescript"
  ],
  "plugins": ["simple-import-sort"],
  "rules": {
    "simple-import-sort/imports": "error",
    "react-hooks/rules-of-hooks": "off",
    "camelcase" : "off",
    "no-restricted-syntax": "off",
    "no-case-declarations": "off"
  }
}